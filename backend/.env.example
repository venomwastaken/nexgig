# Real values go in a local ".env" file, which is never committed.
# This file just documents what variables exist.

DATABASE_URL=""
CLERK_JWKS_URL=""

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default is baked in if unset; in production set this to your
# deployed frontend URL(s), e.g. https://nexgig.vercel.app
ALLOWED_ORIGINS=""

# Cloudflare R2 (S3-compatible) — used for chat image attachments.
# Create a bucket + API token in the Cloudflare dashboard, then set these.
# The bucket also needs a CORS policy allowing PUT from the frontend origin(s).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

RESEND_API_KEY=""
EMAIL_FROM=""

# Paystack — get test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""